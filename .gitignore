# ===========================================================================
#  starpivot-auto-signin / .gitignore
#  提交前请确认:本文件列出的内容都不会被 git 追踪。
# ===========================================================================

# ---- 运行时产物(含个人登录态与账号页面截图,切勿提交)----
chrome-profile/
chrome-profile*/
logs/
screenshots/

# ---- 依赖 ----
node_modules/

# ---- 本地配置 / 密钥 ----
.env
.env.*
!.env.example

# ---- 日志与临时文件 ----
*.log
_tmp-*/
_rmlog.txt

# ---- 编辑器 / IDE ----
.vscode/
.idea/
*.swp
*.swo

# ---- 操作系统自动生成 ----
.DS_Store
Thumbs.db
desktop.ini
