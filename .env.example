# ===========================================================================
# starpivot-auto-signin 可选配置示例
#
# 用法(二选一):
#   1) 复制成 .env,脚本启动时自动读取(零依赖,无需 dotenv)
#        Windows:  copy .env.example .env
#        其他:     cp .env.example .env
#   2) 直接在 shell 里设环境变量(shell 里已设的值优先级更高)
#        PowerShell:  $env:HEADLESS="1"; npm start
#
# 注意:.env 已在 .gitignore 中,不会被提交。本项目不需要也不需要保存
#       任何账号密码 —— 登录态由 chrome-profile/ 目录承载。
# ===========================================================================

# ---- 浏览器 ---------------------------------------------------------------
# Chrome / Edge 可执行文件路径。留空则自动探测系统已安装的 Chrome / Edge:
#   Windows: %ProgramFiles%\Google\Chrome\Application\chrome.exe 等常见位置
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:   /usr/bin/google-chrome、/usr/bin/chromium 等
# 都探测不到时请显式指定,否则启动会报「找不到 Chrome」。
# CHROME_PATH=

# 登录态(Chrome 用户目录)存放位置。默认项目内 ./chrome-profile
# CHROME_USER_DATA_DIR=

# 是否以无头模式运行:不设 = 有头(推荐,Cloudflare 验证需要可见窗口);
# 1 = headless(会被拦截,仅供调试)
# HEADLESS=

# 遇到 Cloudflare 人机验证时,等待人工点勾的最长毫秒数;0 = 不等待,直接失败
# TURNSTILE_WAIT_MS=120000

# ---- 截图 ---------------------------------------------------------------
# 截图**只在出错时**保存(登录失效 / 找不到按钮 / 验证未过),签到成功不留快照。
# 设 0 则完全关闭截图,一个都不落盘。
# SAVE_SCREENSHOTS=0

# ---- 产物保留天数(0 = 永不清理)-------------------------------------------
# LOG_KEEP_DAYS=7
# SHOT_KEEP_DAYS=7
